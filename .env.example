APP_NAME=NightLifeBD
APP_ENV=local
APP_KEY=
# Set APP_DEBUG=false in production
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
SENTRY_DSN=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nightlifebd
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1

# Production recommendation: SESSION_DRIVER=redis, CACHE_STORE=redis,
# QUEUE_CONNECTION=redis, NIGHTLIFE_USE_QUEUE=true, and run Supervisor.

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------- NightLifeBD ----------------
# Every key below is OPTIONAL. Without them the app still works:
#  - no GEMINI key  -> offline keyword analyzer + local text similarity
#  - no ORS key     -> public OSRM demo server for routing
#  - no Telegram    -> contacts are alerted by email only (MAIL_MAILER=log writes mails to storage/logs)

# Google AI Studio key (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# OpenRouteService key (free): https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Telegram bot token from @BotFather (free)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SMS_DRIVER=http
SMS_HTTP_ENDPOINT=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# false = AI analysis runs right after the response (no worker needed). true = use `php artisan queue:work`
NIGHTLIFE_USE_QUEUE=false

# Demo mode disabled by default for production security
NIGHTLIFE_DEMO_ENABLED=false
NIGHTLIFE_REQUIRE_REAL_MAIL=false
NIGHTLIFE_REQUIRE_SMS=false
NIGHTLIFE_PAYMENTS_DRIVER=none
NIGHTLIFE_ROUTING_DRIVER=ors
NIGHTLIFE_AI_ENABLED=true
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
NIGHTLIFE_AI_ENABLED=true
NIGHTLIFE_AI_CIRCUIT_FAILURES=3
NIGHTLIFE_AI_CIRCUIT_MINUTES=10
NIGHTLIFE_DUPLICATE_VECTOR_STORE=sql
